# Copy to .env (all scripts and Next.js read .env). Never commit real secrets.
BOT_TOKEN=123456789:REPLACE_WITH_A_REAL_BOTFATHER_TOKEN
# openssl rand -hex 32; must match setWebhook's secret_token
TELEGRAM_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
# Numeric Telegram IDs, NOT usernames. Only bootstraps a NEW user on first contact.
SUPER_ADMIN_TELEGRAM_IDS=123456789

# Local development. Directory is created by db:migrate.
TURSO_DATABASE_URL=file:./data/warehouse.db
TURSO_AUTH_TOKEN=
# Production: TURSO_DATABASE_URL=libsql://your-database.turso.io
# Production: TURSO_AUTH_TOKEN=your-turso-auth-token

# HTTPS Vercel domain OR ngrok/localtunnel origin (no trailing route required)
APP_URL=https://your-app.vercel.app
STORE_TIMEZONE=Asia/Tehran
CONVERSATION_VERSION=4
# Conservative concurrency; this is not a strict FIFO guarantee. See README.
WEBHOOK_MAX_CONNECTIONS=1
