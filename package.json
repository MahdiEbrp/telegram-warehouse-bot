{
  "name": "telegram-warehouse-bot",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:cleanup": "tsx scripts/cleanup.ts",
    "db:studio": "drizzle-kit studio",
    "webhook:set": "tsx scripts/webhook.ts set",
    "webhook:info": "tsx scripts/webhook.ts info",
    "webhook:delete": "tsx scripts/webhook.ts delete",
    "check": "npm run format:check && npm run typecheck && npm run test:coverage && npm run test:stress && npm run build && npm audit --omit=dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "deploy:check": "tsx scripts/preflight.ts",
    "test:stress": "tsx scripts/stress.ts",
    "test:stress:smoke": "tsx scripts/stress.ts --users 5 --updates 125",
    "ui:preview": "tsx scripts/ui-preview.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "2.1.1",
    "@libsql/client": "0.18.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "grammy": "1.46.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@bonkers-agency/grammy-test": "0.1.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
